# ─── Database ────────────────────────────────────────────────────────────────
# SQLite by default (zero setup). Swap for Postgres with:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite:///./civic_grievance.db

# ─── OpenAI (optional — app runs fully without this) ─────────────────────────
# If unset: Whisper falls back to a placeholder string;
#           GPT-4o-mini falls back to a keyword-rule classifier.
OPENAI_API_KEY=

# ─── Deduplication thresholds ────────────────────────────────────────────────
# Cosine-similarity floor: 0 to 1 (higher = stricter match requirement)
DEDUP_SIMILARITY_THRESHOLD=0.85
# Geographic radius in metres: complaints further apart than this won't merge
DEDUP_RADIUS_METERS=100

# ─── File storage ────────────────────────────────────────────────────────────
# Local directory for uploaded images/audio. In production, swap to S3/GCS
# by replacing the static-file handler in main.py (see README §Production).
UPLOAD_DIR=./uploads

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
